# Server environment variables
# Copy this file to .env and fill in your actual values

# Your OpenRouter API key (get it from https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# AI model to use — cheapest options that won't burn your $10 credit:
#   deepseek/deepseek-chat     → ~$0.14/M tokens (RECOMMENDED)
#   minimax/minimax-01         → free tier available
AI_MODEL=deepseek/deepseek-chat

# WebSocket + HTTP server port
PORT=8080
ocket + HTTP server port
PORT=8080
